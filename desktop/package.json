{
  "name": "pidoo-negocios-escritorio",
  "productName": "Pidoo Negocios",
  "version": "1.0.3",
  "description": "Panel de Pidoo para Windows, con impresora termica y cajon",
  "main": "main.js",
  "author": "Rogotech",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "es.pidoo.negocios",
    "productName": "Pidoo Negocios",
    "files": [
      "main.js",
      "preload.js",
      "impresion.js",
      "impresionUsb.js",
      "build/**",
      "!prueba-*.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pidoo Negocios",
      "artifactName": "pidoo-negocios-${version}-instalador.${ext}"
    }
  }
}
